---
import SEO from "@/components/seo/Seo.astro";
import JsonLD from "../widgets/JsonLD.astro";
import Favicons from "../seo/Favicons.astro";
import OpenGraph from "../seo/OpenGraph.astro";
import config from ".astro/config.generated.json";
import { Font } from "astro:assets";
import fontsJson from "@/config/fonts.json";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
---

<head>
  <meta charset="UTF-8" />
  {
    /*
      BetterCMS visual editor: the page is framed under /__preview/<site>/, where the chunks a
      module script imports from /_astro/ answer 404, so no script runs (animations stay hidden,
      menus are dead). Load each failed module again through the preview path and run the
      DOMContentLoaded handlers it registers. Does nothing on the public site.
    */
  }
  <script is:inline>
    (() => {
      const preview = location.pathname.match(/^\/__preview\/[^/]+/);
      if (!preview) return;
      const failed = [];
      document.addEventListener(
        "error",
        (e) => e.target.tagName === "SCRIPT" && failed.push(e.target),
        true,
      );
      window.addEventListener("load", async () => {
        const handlers = [];
        const add = document.addEventListener;
        document.addEventListener = function (type, fn, options) {
          if (type === "DOMContentLoaded") handlers.push(fn);
          else add.call(this, type, fn, options);
        };
        await Promise.allSettled(
          failed
            .filter((s) => (s.getAttribute("src") || "").startsWith("/"))
            .map((s) => import(preview[0] + s.getAttribute("src"))),
        );
        document.addEventListener = add;
        handlers.forEach((fn) => fn(new Event("DOMContentLoaded")));
      });
    })();
  </script>
  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  <meta name="theme" content="folex-lite" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <SEO
    content={{
      title: Astro.props.title,
      metaTitle: Astro.props.metaTitle,
      description: Astro.props.description,
      metaDescription: Astro.props.metaDescription,
      canonical: Astro.props.canonical,
    }}
    config={config}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={"#fff"}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />
  {
    config.head?.content && (
      // Injecting custom scripts such as Google Analytics, Google Tag Manager, etc. tracking code,
      // which should be placed in <head> tag
      <Fragment set:html={config.head?.content} />
    )
  }
  <OpenGraph
    content={{
      title: Astro.props.title,
      metaTitle: Astro.props.metaTitle,
      description: Astro.props.description,
      metaDescription: Astro.props.metaDescription,
      disableTagline: Astro.props.disableTagline,
    }}
    config={config}
  />
  <Favicons config={config} />
  <JsonLD
    content={{
      title: Astro.props.title,
      metaTitle: Astro.props.metaTitle,
      description: Astro.props.description,
      metaDescription: Astro.props.metaDescription,
      disableTagline: Astro.props.disableTagline,
      pageType: Astro.props.pageType,
    }}
  />

  <!------------------
    Fonts
-------------------->
  {fontVariables.map((font) => <Font cssVariable={font} />)}
</head>
